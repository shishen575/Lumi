# Discord Developer Portal で取得
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Webダッシュボード
# OAuth2 Redirects に ${BASE_URL}/auth/callback を登録する
BASE_URL=http://localhost:3000
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# GitHub push で自動更新(任意)。GitHub の Webhook の Secret と同じ値
GITHUB_WEBHOOK_SECRET=
GIT_BRANCH=main

# 運営のDiscordユーザーID(カンマ区切り)。BOTが入っている全サーバーのダッシュボードを操作できる
OPERATOR_IDS=

# 大喜利: 回答がこの件数たまるごとに、お題を一番下に出し直す(0で無効、既定5)
BUMP_EVERY=5
# 大喜利: この分数ごとに、新しい回答があればお題を出し直す(0で無効、既定0)
BUMP_MINUTES=0
