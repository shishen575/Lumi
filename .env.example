# Discord Developer Portal で取得
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Webダッシュボード
# OAuth2 Redirects に ${BASE_URL}/auth/callback を登録する
BASE_URL=http://localhost:3000
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# GitHub push で自動更新(任意)。GitHub の Webhook の Secret と同じ値
GITHUB_WEBHOOK_SECRET=
GIT_BRANCH=main
